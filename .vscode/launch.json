{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Marp Server starten (Live Preview)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "▶ Build All (HTML, PDF, PPTX)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:all"],
      "console": "integratedTerminal"
    }
  ]
}
